{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": {
    "source": "dist/apps/functions",
    "predeploy": ["pnpm nx build functions"],
    "runtime": "nodejs22"
  },
  "hosting": [
    {
      "target": "web",
      "public": "dist/apps/web/browser",
      "ignore": ["firebase.json", "**/.*"],
      "rewrites": [{ "source": "**", "destination": "/index.html" }]
    }
  ],
  "emulators": {
    "//": "Every emulator binds to 0.0.0.0, not the default 127.0.0.1, so a phone on the same Wi-Fi can reach auth/firestore/functions/storage at the dev machine's LAN IP. Local-only by nature — these are demo-project emulators with no real credentials behind them.",
    "firestore": {
      "host": "0.0.0.0",
      "port": 8080
    },
    "auth": {
      "host": "0.0.0.0",
      "port": 9099
    },
    "functions": {
      "host": "0.0.0.0",
      "port": 5001
    },
    "storage": {
      "host": "0.0.0.0",
      "port": 9199
    },
    "hosting": {
      "host": "0.0.0.0",
      "port": 5000
    },
    "ui": {
      "enabled": false
    }
  }
}
