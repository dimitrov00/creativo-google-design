# The one source of names for the platform backstops (audit-hardening WS-6).
#
# Sourced by every tools/ops/*.sh script and read by the production
# preflight's P9 (tools/verify/preflight/preflight.mjs), which parses it
# without a shell — so: plain KEY=value lines only, a value single-quoted
# when the shell would read it otherwise, no expansion, no command.
# tools/verify/ops/ops-scripts.spec.mjs pins the alert files against the
# metric names below.

# Firestore: the database every script and P9 address.
DATABASE_ID='(default)'

# Cloud Logging: the 400-day audit bucket and the sink that routes into it
# (tools/ops/log-sink.sh; runbook §2.5). `global` is the bucket's location.
LOG_SINK_NAME=creativo-audit-sink
LOG_BUCKET_ID=creativo-audit-400d
LOG_BUCKET_LOCATION=global
LOG_BUCKET_RETENTION_DAYS=400

# Firestore backstops (tools/ops/firestore-backups.sh). PITR keeps 7 days of
# versions — the one window Firestore offers; the schedule keeps each daily
# backup 28 days (gcloud's --retention spelling, at most 14 weeks).
PITR_DAYS=7
BACKUP_RECURRENCE=daily
BACKUP_RETENTION=28d

# Logs-based metrics (tools/ops/log-metrics.sh; the alerts in tools/ops/alerts/).
METRIC_CLIENT_ISSUES=client_issue_count
METRIC_TRIGGER_ATTEMPT_FAILED=trigger_attempt_failed
METRIC_DOCUMENT_REFUSED=document_refused
METRIC_AUDIT_ACTOR_MISSING=audit_actor_missing
METRIC_CALLABLE_FAILED=callable_failed
METRIC_ROLES_SESSIONS_NOT_REVOKED=roles_sessions_not_revoked
