{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../../dist/out-tsc",
    "declaration": true,
    "declarationMap": true,
    "inlineSources": true,
    "types": [],
    "composite": true,
    "rootDir": "../../..",
    "sourceMap": true
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "src/**/*.integration.spec.ts",
    "src/testing/**"
  ],
  "references": [
    {
      "path": "../firebase-app/tsconfig.lib.json"
    },
    {
      "path": "../../ecs-core/tsconfig.lib.json"
    }
  ]
}
