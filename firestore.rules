rules_version = '2';

// Fresh, greenfield schema (migration-blueprint.md §0.4/§6, Goal 04). This
// REPLACES the earlier generic tenant-scoped draft (`tenants/{tenantId}/...`)
// that predates the bounded-context domain model — that shape has no
// relationship to the schema below (see docs/architecture/domain-deviations.md).
//
// Philosophy (ported from v2, `v2/firestore.rules`): default-deny root, every
// collection opts in explicitly. `otps`/`rateLimits`/`blocklist` stay fully
// closed — Cloud Functions write them via the Admin SDK, which bypasses rules
// entirely. Roles come from a `roles: string[]` custom claim on the ID token
// (`AuthClaims.activeClaims`, `@creativo/domain/identity`) — minted by
// Cloud Functions (Phase 7), never self-assigned by a client write.
//
// Verify with the Firestore Rules Emulator / `@firebase/rules-unit-testing`
// before treating a change here as final — see
// `libs/infrastructure/firestore/src/lib/firestore.rules.integration.spec.ts`.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function roles() {
      return isSignedIn() && 'roles' in request.auth.token
        ? request.auth.token.roles
        : [];
    }

    function hasAnyRole(candidates) {
      return roles().hasAny(candidates);
    }

    // Everyone who isn't a plain `client` — mirrors
    // `@creativo/domain/accounts`' `isStaff` (barber | receptionist |
    // content_manager | admin | sysadmin).
    function isStaff() {
      return hasAnyRole(['barber', 'receptionist', 'content_manager', 'admin', 'sysadmin']);
    }

    /**
     * The roles that WORK THE BOOK. Deliberately narrower than `isStaff()`:
     * `content_manager` is a copy-and-media role and has no business reading
     * every client's name, phone and note in the shop.
     */
    function worksTheBook() {
      return hasAnyRole(['barber', 'receptionist', 'admin', 'sysadmin']);
    }

    /**
     * Who may rewrite a chair's hours or declare it absent.
     *
     * The intended rule is SELF-OR-MANAGER, and it is not expressible yet:
     * `Barber` deliberately carries no `userId`, so no token claim can say
     * which chair the caller IS. Until that link exists this is the honest
     * subset — everyone who works the book, minus `content_manager`, which
     * is the part that was actually dangerous (a copy role could rewrite
     * every barber's roster, and utilisation history divides by it).
     *
     * Narrow this to true self-or-manager the moment `Barber ↔ User` lands.
     */
    function mayEditRoster() {
      return worksTheBook();
    }

    function isCatalogManager() {
      return hasAnyRole(['content_manager', 'admin', 'sysadmin']);
    }

    function isAdmin() {
      return hasAnyRole(['admin', 'sysadmin']);
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function affectedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Default deny — every collection below must opt in explicitly.
    match /{document=**} {
      allow read, write: if false;
    }

    // ── accounts ────────────────────────────────────────────────────────
    match /users/{uid} {
      // A client sees their own doc; staff may GET any profile (a booking
      // names its client). LISTING — the search surface over everyone's
      // phone/email/birthDate — is front-desk and admin business only: a
      // `content_manager` edits the catalog, not the clientele, and every
      // role in `isStaff()` could previously dump the whole collection.
      allow get: if isOwner(uid) || isStaff();
      allow list: if isOwner(uid)
        || hasAnyRole(['receptionist', 'admin', 'sysadmin']);

      // Self-registration always starts as a plain `client` — every other
      // role is granted server-side only (Admin SDK bypasses these rules).
      allow create: if isOwner(uid) && request.resource.data.roles == ['client'];

      // A client may edit their own profile fields but can never grant
      // themselves a role or change their own account status (block/unblock
      // is staff/admin-only, done through a Cloud Function).
      allow update: if isOwner(uid) && !affectedKeys().hasAny(['roles', 'status']);
      allow update: if isAdmin();

      allow delete: if false;

      match /rewardProgress/{programId} {
        // Materialized by Cloud Functions only (reward-progress sweep,
        // Phase 7) — matches v2's owner-read/server-write split exactly.
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /notifications/{notificationId} {
        // The recipient's own inbox. Delivered server-side only (the
        // waitlist matcher writes here via the Admin SDK, which bypasses
        // these rules) — a client that could write its own notifications
        // could forge a "your slot is free" message.
        allow read: if isOwner(uid);
        // The ONE thing a recipient may change is their own read receipt.
        // Everything else — what the message says, who it is from, where it
        // points — is the sender's, and a client that could rewrite `body`
        // or `deepLink` could turn its own inbox into a phishing surface.
        allow update: if isOwner(uid)
          && affectedKeys().hasOnly(['readAtIso']);
        allow create, delete: if false;
      }
    }

    // TOP-LEVEL `couponGrants/{grantId}`, owner in the `userId` field. The
    // subcollection layout this replaces needed a `{path=**}` collection-
    // group rule that any signed-in account could dump EVERY user's grants
    // through — the rule could not condition on `resource.data.userId`
    // because the CG query filtered on a different field and failed the
    // static list-time check. Top-level, `get` proves ownership on the doc
    // itself, and `list` is only legal when the query's own filter pins
    // `userId` to the caller (which `findUsableForUser` does).
    match /couponGrants/{grantId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn()
        && resource.data.userId == request.auth.uid;
      // Grants are minted server-side only; the owner may transition their
      // own grant's `state` (active → used), nothing security-relevant.
      // Deliberately NOT `affectedKeys().hasOnly(['state'])` — `grantedAt`
      // is free to re-serialize to a different (but instant-equal) ISO
      // string across a read→reconstitute→persist round trip. What actually
      // must never change is the grant's identity/value/ownership.
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && !affectedKeys().hasAny(['id', 'userId', 'couponId', 'value']);
      allow create, delete: if false;
    }

    // ── scheduling ──────────────────────────────────────────────────────
    match /appointments/{appointmentId} {
      // `ownerUserId` is a denormalized field (not part of the `Appointment`
      // domain aggregate) written by the adapter purely so rules/queries can
      // identify "my appointments" without scanning the `seats` array.
      // NOT `isStaff()`: that grouping includes `content_manager`, which
      // could read every appointment, every client name, phone and note in
      // the shop for a role that only edits marketing copy.
      allow read: if worksTheBook()
        || (isSignedIn() && resource.data.ownerUserId == request.auth.uid);

      // CLIENTS MAY NOT CREATE APPOINTMENTS. This previously allowed any
      // signed-in user to write an appointment naming any barber, any time and
      // any price, on top of anyone else's booking — the document carries
      // `seats[].terms.priceMinorUnits` and `seats[].slot`, and rules cannot
      // check availability. Double-booking was the default behaviour, not a
      // race.
      //
      // A booking is now committed by the `commitBooking` callable, which runs
      // a transaction that resolves terms server-side via
      // `Service.termsFor(barberId, variantId)` and re-checks the barber-day
      // projection before writing. The Admin SDK bypasses these rules, so no
      // allowance for it is needed (or wanted) here.
      //
      // NO direct writes for anyone — staff included. The earlier
      // `create: if isStaff()` let a receptionist write an appointment the
      // availability engine never saw: the commit transaction conflict-checks
      // `barberBusy` only, and a direct doc write updates no projection, so
      // the sanctioned walk-in path was a guaranteed double-booking. The
      // owner direct-cancel grant was equally dead — the browser repository
      // refuses `save()`, and a rules-level status flip would have left the
      // slot phantom-blocked in `barberBusy` forever. Every lifecycle write
      // goes through a callable (`commitBooking`, `cancelAppointment`,
      // `rescheduleAppointment`, `transitionAppointment`, `markArrived`,
      // `staffEditAppointment`), and the `rebuildBusy` trigger keeps the
      // projection equal to what the appointments say.
      //
      // `staffEditAppointment` — the staff move/resize/re-price path — adds
      // NOTHING here on purpose. It is the callable that finally lets a barber
      // move a booking, and the temptation is to grant staff a direct write
      // now that a staff surface writes at all. It stays refused: the reasons
      // above are unchanged by who is asking. Rules cannot check availability,
      // cannot re-resolve a price against the catalogue, and cannot update
      // `barberBusy` — a receptionist's direct write would be exactly the
      // guaranteed double-booking the old `create: if isStaff()` was.
      //
      // Note the READ rule above is `worksTheBook()`, deliberately narrower
      // than `isStaff()`. Every appointment callable now gates on the SAME
      // grouping (`worksTheBook` in `@creativo/domain/accounts`); before that,
      // `content_manager` could not read an appointment but could transition
      // one — the wrong way round.
      allow create: if false;
      allow update: if false;

      // Never hard-delete — status transitions only, so day-sheets and
      // history/analytics stay intact.
      allow delete: if false;
    }

    // ── catalog (public browse, staff/content-manager write) ──────────────
    match /serviceCategories/{categoryId} {
      allow read: if true;
      allow write: if isCatalogManager();
    }

    match /services/{serviceId} {
      allow read: if true;
      allow write: if isCatalogManager();
    }

    match /barbers/{barberId} {
      allow read: if true;
      allow write: if isCatalogManager();
    }

    match /locations/{locationId} {
      allow read: if true;
      allow write: if isCatalogManager();
    }

    // ── availability (public read, PII-free by construction) ─────────────
    // `/book` is browsable ANONYMOUSLY, and rules cannot redact fields: a
    // document is readable whole or not at all. So the two collections a
    // visitor needs in order to see a free slot hold geometry and nothing
    // else — no client identity, no service, no price, and above all no
    // reason (a `sick` day is GDPR Art. 9 special-category data and must
    // never reach this surface). Anything richer belongs in `appointments`,
    // which stays closed.
    match /barberSchedules/{barberId} {
      allow read: if true;
      // Rosters are staff-authored; utilisation history DIVIDES BY THEM, so
      // a blanket staff write let any barber rewrite any other barber's hours
      // (and a `content_manager` rewrite all of them), silently changing
      // everyone's utilisation denominator.
      allow write: if mayEditRoster();
    }

    match /scheduleExceptions/{dayDocId} {
      // The sanitized availability effect of a day off / changed hours —
      // geometry only, structurally reason-free (the doc schema has no field
      // a reason could ride in; a `sick` day must never be derivable here).
      allow read: if true;
      // Same boundary as the roster it overrides — see `mayEditRoster`.
      allow write: if mayEditRoster();
    }

    match /capacity/{monthId} {
      // The calendar's month rollup — free minutes per day/barber/shop,
      // trigger-maintained (Admin SDK). Same PII posture as barberBusy:
      // geometry-derived numbers only.
      allow read: if true;
      allow write: if false;
    }

    match /barberLeadTimeSamples/{sampleId} {
      // How far out each barber's first free day was, sampled daily by
      // `sampleBarberLeadTimeDaily` (Admin SDK, so no write allowance is
      // needed or wanted here).
      //
      // STAFF-ONLY, unlike the capacity rollup it is derived from — and the
      // difference is deliberate. Capacity says "this day has free minutes",
      // which is what a visitor already learns from the booking calendar. A
      // lead-time SERIES says how heavily booked the shop is and which way
      // that is trending, which is commercial intelligence: it is the number
      // a competitor would use to time their own pricing, and no client needs
      // it to book a haircut.
      allow read: if isStaff();
      allow write: if false;
    }

    match /barberBusy/{dayDocId} {
      allow read: if true;
      // Written ONLY by the `commitBooking` transaction (Admin SDK, which
      // bypasses rules). A client that could widen its own busy projection
      // could hide a barber's free time from everyone else.
      allow write: if false;
    }

    match /waitlistRequests/{requestId} {
      // A standing request to be told when a day opens up. The owner reads
      // their own; staff read all of them, because "who is waiting for
      // Saturday" is a question the shop legitimately asks.
      allow read: if isSignedIn()
        && (isOwner(resource.data.ownerUserId) || isStaff());

      // Written ONLY by `requestWaitlist` and the matcher (Admin SDK, which
      // bypasses rules). A client that could write its own document could
      // name a different owner and sign a stranger up for notifications, or
      // set `dayKeys` wider than the days it actually declared and make the
      // matcher do unbounded work on every cancellation.
      allow create: if false;

      // Withdrawal goes through the `cancelWaitlist` callable — ONE door.
      // A direct-write grant briefly lived here that nothing exercised (the
      // client gateway already called the callable, which didn't exist);
      // two sanctioned paths to one transition is how they drift.
      allow update: if false;

      allow delete: if false;
    }

    // ── programs (public browse, staff/content-manager write) ─────────────
    // Open positions, courses, and shop events — same posture as catalog:
    // public read, `content_manager`/`admin`/`sysadmin` write.
    match /positions/{positionId} {
      allow read: if true;
      allow write: if isCatalogManager();
    }

    match /courses/{courseId} {
      allow read: if true;
      allow write: if isCatalogManager();
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if isCatalogManager();
    }

    // ── engagement ──────────────────────────────────────────────────────
    // Deviation from v2 (which left `coupons` closed entirely): a
    // `CouponGrant` here only embeds its own `CouponValue` snapshot, not the
    // coupon's display name/policy, so the client-side repository joins
    // against the `Coupon` definition doc — see domain-deviations.md.
    match /coupons/{couponId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /rewardPrograms/{programId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /invitations/{invitationId} {
      // GET only for a plain user: the client flow is a point lookup of a
      // code someone handed you. `read` covered `list` too, which let any
      // fresh account enumerate every invitation and self-redeem it.
      allow get: if isSignedIn();
      allow list: if isStaff();
      allow create: if isSignedIn()
        && request.resource.data.inviterUserId == request.auth.uid
        && request.resource.data.redemptionCount == 0;
      // `redemptionCount` only ever moves forward by exactly one, driven by
      // a redemption being recorded (see the `redemptions` rule below) — no
      // other field on an invitation is ever mutated by a client.
      allow update: if isSignedIn()
        && affectedKeys().hasOnly(['redemptionCount'])
        && request.resource.data.redemptionCount == resource.data.redemptionCount + 1;
      allow delete: if false;

      match /redemptions/{refereeUserId} {
        // Same split: doc ids ARE referee uids, so a listing is a referral
        // graph dump.
        allow get: if isSignedIn();
        allow list: if isStaff();
        // Doc id IS the referee's uid — existence alone prevents double
        // redemption; self-redemption is rejected by requiring the doc id
        // to differ from the parent invitation's inviter.
        allow create: if isOwner(refereeUserId)
          && get(/databases/$(database)/documents/invitations/$(invitationId)).data.inviterUserId != refereeUserId;
        allow update, delete: if false;
      }
    }

    // ── governance (admin-tier only) ───────────────────────────────────
    match /impersonationSessions/{sessionId} {
      allow read, write: if isAdmin();
    }

    match /auditLog/{entryId} {
      // Append-only — admins can read and create, never update or delete.
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // ── tenant settings ─────────────────────────────────────────────────
    // `settings/bookingPolicy` and siblings. Public-read because the booking
    // horizon is literally how far an anonymous visitor's calendar scrolls —
    // and the doc holds tuning numbers, nothing secret. The missing match
    // here once default-denied every `/book` session into a silent
    // defaults-only policy plus a per-tab retry loop.
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── server-only (Admin SDK bypasses rules; closed to every client) ──
    match /otps/{otpId} {
      allow read, write: if false;
    }

  }
}
