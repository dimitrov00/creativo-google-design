rules_version = '2';

// Every document below is the flat archetype of its `@core/entities` entity
// minus `id` (Law 5), its collection spelled once in `Collections`
// (`libs/ecs-core/src/entities/collections.ts`), and every rule tests root
// keys only.
//
// Default-deny root: every collection opts in explicitly, so a path no match
// names stays closed. A collection no client writes (`allow write: if false`,
// `otps` closed both ways) is written by Cloud Functions through the Admin
// SDK, which bypasses rules entirely — the callables, triggers and scheduled
// jobs of `apps/functions`, through its server adapters
// (`apps/functions/src/adapters`). The browser reads and writes through the
// `(db) => bundle` adapters of `libs/infrastructure/firestore` and
// `libs/infrastructure/storage`, bound in `apps/web/src/app/app.config.ts`.
//
// Roles come from a `roles: string[]` custom claim on the ID token
// (`AuthClaims.active`, `@core/components`) — minted by Cloud Functions
// (`verifyOtpChallenge`, `completeRegistration`), never self-assigned by a
// client write.
//
// Verify with the Firestore Rules Emulator / `@firebase/rules-unit-testing`
// before treating a change here as final — see
// `libs/infrastructure/firestore/src/lib/firestore.rules.integration.spec.ts`.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function roles() {
      return isSignedIn() && 'roles' in request.auth.token
        ? request.auth.token.roles
        : [];
    }

    function hasAnyRole(candidates) {
      return roles().hasAny(candidates);
    }

    // Everyone who isn't a plain `client` — mirrors `STAFF_ROLES` / `isStaff`
    // in libs/ecs-core/src/components/role.data.ts (barber | receptionist |
    // content_manager | admin | sysadmin), pinned by role.rules-parity.spec.ts.
    function isStaff() {
      return hasAnyRole(['barber', 'receptionist', 'content_manager', 'admin', 'sysadmin']);
    }

    /**
     * The roles that WORK THE BOOK. Deliberately narrower than `isStaff()`:
     * `content_manager` is a copy-and-media role and has no business reading
     * every client's name, phone and note in the shop.
     */
    function worksTheBook() {
      return hasAnyRole(['barber', 'receptionist', 'admin', 'sysadmin']);
    }

    /**
     * Who may change a chair's hours for a day or declare it absent — the
     * `scheduleExceptions` grant. (The weekly roster itself,
     * `barberSchedules`, has no client writer since pass E, DEP-6.)
     *
     * The intended rule is SELF-OR-MANAGER, and it is not expressible yet:
     * `Barber` deliberately carries no `userId`, so no token claim can say
     * which chair the caller IS. Until that link exists this is the honest
     * subset — everyone who works the book, minus `content_manager`, which
     * is the part that was actually dangerous (a copy role could rewrite
     * every barber's roster, and utilisation history divides by it).
     *
     * Narrow this to true self-or-manager the moment `Barber ↔ User` lands.
     */
    function mayEditRoster() {
      return worksTheBook();
    }

    function isCatalogManager() {
      return hasAnyRole(['content_manager', 'admin', 'sysadmin']);
    }

    function isAdmin() {
      return hasAnyRole(['admin', 'sysadmin']);
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function affectedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ── the programs bodies (pass E, E-15 / DEP-7) ──────────────────────
    // A programs write must BE its document: the flat `Position`, `Course`
    // or `ShopEvent` (`@core/entities`) minus `id`, every key present
    // (`null` for none, never absent), each value of its type. These mirror
    // what `ProgramsSystem` admits on the way in and are never stricter
    // than it: where the rules cannot repeat a check (a URL the parser
    // accepts, a real calendar day, an integer sort order, trimmed text)
    // they test the looser shape around it.

    /** `LocalizedText` (`@core/components`): exactly `{ bg, en }`, both non-empty strings. */
    function isLocalizedText(v) {
      return v is map
        && v.keys().hasOnly(['bg', 'en'])
        && v.keys().hasAll(['bg', 'en'])
        && v.bg is string && v.bg.size() > 0
        && v.en is string && v.en.size() > 0;
    }

    function isLocalizedTextOrNull(v) {
      return v == null || isLocalizedText(v);
    }

    /** An `applyUrl`: `null` (the shop's shared contact link) or a non-empty string. */
    function isLinkOrNull(v) {
      return v == null || (v is string && v.size() > 0);
    }

    /** A `LocationId` (non-empty, no `/`) or `null` (no single shop). */
    function isLocationIdOrNull(v) {
      return v == null || (v is string && v.matches('^[^/]+$'));
    }

    /** A list order: a number `>= 0` (the system admits integers `>= 0`). */
    function isSortOrder(v) {
      return v is number && v >= 0;
    }

    /** `positions/{id}` — `Position` minus `id`; `positionStatus` a `PositionStatus` tag. */
    function validPosition(d) {
      return d.keys().hasOnly(['title', 'summary', 'locationIds', 'positionStatus', 'applyUrl', 'sortOrder'])
        && d.keys().hasAll(['title', 'summary', 'locationIds', 'positionStatus', 'applyUrl', 'sortOrder'])
        && isLocalizedText(d.title)
        && isLocalizedText(d.summary)
        && d.locationIds is list
        && d.positionStatus in ['OPEN', 'CLOSED']
        && isLinkOrNull(d.applyUrl)
        && isSortOrder(d.sortOrder);
    }

    /** `courses/{id}` — `Course` minus `id`; `enrollmentStatus` an `EnrollmentStatus` tag. */
    function validCourse(d) {
      return d.keys().hasOnly(['title', 'description', 'enrollmentStatus', 'startsLabel', 'applyUrl', 'sortOrder'])
        && d.keys().hasAll(['title', 'description', 'enrollmentStatus', 'startsLabel', 'applyUrl', 'sortOrder'])
        && isLocalizedText(d.title)
        && isLocalizedText(d.description)
        && d.enrollmentStatus in ['OPEN', 'UPCOMING', 'CLOSED']
        && isLocalizedTextOrNull(d.startsLabel)
        && isLinkOrNull(d.applyUrl)
        && isSortOrder(d.sortOrder);
    }

    /**
     * `events/{id}` — `ShopEvent` minus `id`: the shop wall clock
     * (`localDate` `YYYY-MM-DD`, `startMinutes` a `MinuteOfDay` in
     * `[0, 1440)`) and the instant computed once at ingestion
     * (`utcEpochMs`, an integer). No zone field (Law 7.2).
     */
    function validEvent(d) {
      return d.keys().hasOnly(['title', 'description', 'localDate', 'startMinutes', 'utcEpochMs', 'locationId', 'applyUrl', 'sortOrder'])
        && d.keys().hasAll(['title', 'description', 'localDate', 'startMinutes', 'utcEpochMs', 'locationId', 'applyUrl', 'sortOrder'])
        && isLocalizedText(d.title)
        && isLocalizedText(d.description)
        && d.localDate is string
        && d.localDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.startMinutes is int
        && d.startMinutes >= 0
        && d.startMinutes < 1440
        && d.utcEpochMs is int
        && isLocationIdOrNull(d.locationId)
        && isLinkOrNull(d.applyUrl)
        && isSortOrder(d.sortOrder);
    }

    // Default deny — every collection below must opt in explicitly.
    match /{document=**} {
      allow read, write: if false;
    }

    // ── accounts ────────────────────────────────────────────────────────
    match /users/{uid} {
      // A client sees their own doc; the roles that work the book may GET
      // any profile (a booking names its client). NOT `isStaff()` (FIX 5,
      // 2026-09-25): a `content_manager` edits the catalog, not the
      // clientele, and reads no one's name, phone or birth date but its own.
      // LISTING — the search surface over everyone's phone/email/birthDate —
      // is front-desk and admin business only.
      allow get: if isOwner(uid) || worksTheBook();
      allow list: if isOwner(uid)
        || hasAnyRole(['receptionist', 'admin', 'sysadmin']);

      // The document is the flat `User` (`@core/entities`) minus `id`: every
      // key at the root in both states — `registrationState`, the contact
      // and names, `roles`, `accountStatus` (+ `blockReason`,
      // `blockedUntilUtcMs` while BLOCKED) and the search keys.
      // No client ever writes this document (Phase 4a 4A-3 (3)). Every
      // write is the Admin SDK's (which bypasses these rules): `verifyOtp`
      // creates the PROVISIONED stub (`RegistrationSystem.provision`: the
      // login channel only, names `null`, `roles: []`),
      // `completeRegistration` sets the REGISTERED body over it,
      // `updateProfile` writes the owner's names and birth date (the search
      // keys re-derived, the `profileEditedAtUtcMs` marker beside ONE audit
      // row credited to the user, in one transaction), and the account
      // blocks move `accountStatus`. The owner's direct update — FIX 2's
      // allowlist with its value checks — closed with the callable that
      // replaced it: a client write could neither audit itself nor keep the
      // search keys honest. Roles and the account status were never a
      // client's (FIX 3, 2026-09-25: no admin update either — overlapping
      // allows are OR'd).
      allow create, update, delete: if false;

      match /notifications/{notificationId} {
        // The recipient's own inbox (`InboxNotification`). Delivered
        // server-side only (the waitlist matcher writes here via the Admin
        // SDK, which bypasses these rules) — a client that could write its
        // own notifications could forge a "your slot is free" message.
        allow read: if isOwner(uid);
        // The ONE thing a recipient may change is their own read stamp,
        // `readAtUtcMs` (the flat root field `inboxPorts.markNotificationRead`
        // stamps).
        // Everything else — the topic, what it is about, when it was sent —
        // is the sender's, and a client that could rewrite the payload
        // could turn its own inbox into a phishing surface.
        allow update: if isOwner(uid)
          && affectedKeys().hasOnly(['readAtUtcMs']);
        allow create, delete: if false;
      }
    }

    // TOP-LEVEL `couponGrants/{grantId}` (`CouponGrant`): the client record
    // it rewards in `customerId`, the account that may READ it in
    // `holderUserId` (D29 — written at the boundary from the record's
    // `Customer.userId`, never derived from the record id's text; `null` for
    // a grant held by a walk-in, which no client reads). Top-level, `get`
    // proves ownership on the document itself, and `list` is only legal
    // when the query's own filter pins `holderUserId` to the caller.
    // …and the BOOK may read them too (2026-09-10): a barber at the chair
    // honours a coupon the client already holds, which means the visit
    // sheet has to list the client's usable grants. Same predicate the
    // clientele read uses — a copy-and-media role still sees nothing.
    match /couponGrants/{grantId} {
      allow get: if isSignedIn()
        && (resource.data.holderUserId == request.auth.uid || worksTheBook());
      allow list: if isSignedIn()
        && (resource.data.holderUserId == request.auth.uid || worksTheBook());
      // Grants are minted, used and revoked server-side only (the commit
      // plans' writes). The owner's exclusion-list update that
      // stood here let a client flip its own grant's lifecycle — a used
      // grant back to active included — and nothing a client sanctioned
      // ever needed it: a grant's `grantStatus` moves inside the server
      // transaction that redeems it, or not at all.
      allow update: if false;
      allow create, delete: if false;
    }

    // ── scheduling ──────────────────────────────────────────────────────
    match /appointments/{appointmentId} {
      // `ownerUserId` is the `SELF` seat's ACCOUNT, a query mirror every write
      // plan recomputes from the seats, so rules/queries can identify "my
      // appointments" without scanning the `seats` array (D29: it stays the
      // account key beside the client-record mirror `ownerCustomerId`).
      // NOT `isStaff()`: that grouping includes `content_manager`, which
      // could read every appointment, every client name, phone and note in
      // the shop for a role that only edits marketing copy.
      allow read: if worksTheBook()
        || (isSignedIn() && resource.data.ownerUserId == request.auth.uid);

      // CLIENTS MAY NOT CREATE APPOINTMENTS. This previously allowed any
      // signed-in user to write an appointment naming any barber, any time and
      // any price, on top of anyone else's booking — the document carries
      // `seats[].priceCents` and `seats[].startMinutes`, and rules cannot
      // check availability. Double-booking was the default behaviour, not a
      // race.
      //
      // A booking is now committed by the `commitBooking` callable, which runs
      // a transaction that resolves terms server-side
      // (`OfferingPriceSystem.termsFor`) and re-checks the barber-day
      // projection before writing. The Admin SDK bypasses these rules, so no
      // allowance for it is needed (or wanted) here.
      //
      // NO direct writes for anyone — staff included. The earlier
      // `create: if isStaff()` let a receptionist write an appointment the
      // availability engine never saw: the commit transaction conflict-checks
      // `barberBusy` only, and a direct doc write updates no projection, so
      // the sanctioned walk-in path was a guaranteed double-booking. The
      // owner direct-cancel grant was equally dead — the web's appointment
      // ports (`appointmentReadPorts`) only read, and a rules-level status
      // flip would have left the slot phantom-blocked in `barberBusy`
      // forever. Every lifecycle write goes through a callable
      // (`commitBooking`, `cancelAppointment`, `rescheduleAppointment`,
      // `transitionAppointment`, `markArrived`, `clearArrival`,
      // `recordSeatTip`, `staffEditAppointment`), and the
      // `rebuildBusyOnAppointmentChange` trigger keeps the projection equal
      // to what the appointments say.
      //
      // `staffEditAppointment` — the staff move/resize/re-price path — adds
      // NOTHING here on purpose. It is the callable that finally lets a barber
      // move a booking, and the temptation is to grant staff a direct write
      // now that a staff surface writes at all. It stays refused: the reasons
      // above are unchanged by who is asking. Rules cannot check availability,
      // cannot re-resolve a price against the catalogue, and cannot update
      // `barberBusy` — a receptionist's direct write would be exactly the
      // guaranteed double-booking the old `create: if isStaff()` was.
      //
      // Note the READ rule above is `worksTheBook()`, deliberately narrower
      // than `isStaff()`. Every appointment callable now gates on the SAME
      // grouping (`BOOK_ROLES` in libs/ecs-core/src/components/role.data.ts,
      // pinned to `worksTheBook()` by role.rules-parity.spec.ts); before that,
      // `content_manager` could not read an appointment but could transition
      // one — the wrong way round.
      allow create: if false;
      allow update: if false;

      // Never hard-delete — status transitions only, so day-sheets and
      // history/analytics stay intact.
      allow delete: if false;
    }

    // ── the team's note on a visit ─────────────────────────────────────
    // Staff-only in BOTH directions, and a sibling of the appointment on
    // purpose: the appointment document is readable by its owner, so a note
    // the shop writes about a client can never live on it. `worksTheBook()`,
    // not `isStaff()` — a marketing role has no business reading these. The
    // visit editor reads and saves it through `appointmentNotePorts`.
    match /appointmentNotes/{appointmentId} {
      allow read, write: if worksTheBook();
    }

    // ── the shop's photos of a visit ─────────────────────────────────────
    // Staff-only in both directions and a sibling of the appointment, for
    // the note's reason: the appointment document is the client's to read,
    // the shop's pictures of them are not. One document per photo, pointing
    // at the visit; the bytes sit in Storage under the same rule
    // (`storage.rules`, `/appointmentPhotos`), and `appointmentPhotoPorts`
    // (`libs/infrastructure/storage`) writes both halves.
    match /appointmentPhotos/{photoId} {
      allow read, write: if worksTheBook();
    }

    // ── the shop's client records (D29) ──────────────────────────────────
    // `customers/{customerId}` — whom the shop serves, bills and rewards,
    // with or without an account (`Customer`). The book reads and keeps
    // them; the account a record names (`userId`) reads its own and nothing
    // else (`customerPorts.loadCustomerForUser`) — a client may never see
    // the desk's copy of another person, and no anonymous visitor any. The
    // booking transaction (`FIRST_BOOKING`) and `completeRegistration`
    // (`REGISTRATION`) create an account holder's record with the Admin
    // SDK; the desk's `create`/`update` is the walk-in path's
    // (flatten-spec §5.5). Records are never deleted from a client: a
    // visit, a grant or a voucher may name one.
    match /customers/{customerId} {
      allow read: if worksTheBook()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create, update: if worksTheBook();
      allow delete: if false;
    }

    // ── the client's visit statistics (2026-09-25) ───────────────────────
    // Visits, no-shows, late cancels, cadence — materialised per subject by
    // the appointments trigger and the backfill (Admin SDK), never by a
    // client. The book reads them; the client they describe does not: the
    // document carries the staff-only pause suggestion, and a client's own
    // visits reach them through the journal instead.
    // Keyed by the client RECORD (`clientStats/{customerId}`, D29) — staff
    // read it by the record, so the key changes nothing about who may.
    match /clientStats/{customerId} {
      allow read: if worksTheBook();
      allow write: if false;

      // `restricted/money` — lifetime spend. Rules cannot hide a field, so
      // money lives in its own document, and rules do not cascade, so this
      // match needs its own allow. The shop's admin only: NOT sysadmin, a
      // support role with no business in a client's spend, and not the
      // front desk.
      match /restricted/{docId} {
        allow read: if hasAnyRole(['admin']);
        allow write: if false;
      }
    }

    // ── the loyalty read model (client-card-redesign §4.5, 2026-09-28) ──
    // The catalogue — shelves, medal families, seasons and events, tiers,
    // rewards, the rhythm — is presentation, not personal data: anyone
    // signed in reads it (clients will, once they see their own loyalty).
    // Nobody writes it from a client: it is published by the server.
    match /badgeCategories/{categoryId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /badgeSeries/{seriesId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /seasons/{seasonId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /tierDefinitions/{tierId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /rewardsCatalog/{rewardId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // THE RHYTHM'S RULE (client-card-revision-3 §4.3, 2026-09-29). The
    // head's flat `rules` list holds the rule in force (`CURRENT`) and at
    // most one that waits (`SCHEDULED`): staff read it now, clients will
    // with their own loyalty view. Nobody writes it from a client, the
    // admin included: a rule is published by the `publishStreakDefinition`
    // callable, which checks the change, the day it may take effect and the
    // caller, and writes the head, the version and the audit row in one
    // transaction.
    match /streakDefinitions/{streakId} {
      allow read: if isSignedIn();
      allow write: if false;

      // Every publish, immutable: who changed the rule, when, and how. The
      // history is the admin page's. Rules do not cascade, so the
      // subcollection states its own allow.
      match /versions/{version} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    // A client's account and progress: the book reads them, the server
    // writes them. The client they describe does not read them yet — that
    // joins with their own loyalty view. Keyed by the client RECORD
    // (`loyaltyAccounts/{customerId}`, D29, flip 3) — staff read it by the
    // record they resolved, so the key changes nothing about who may. Rules
    // do not cascade, so each subcollection states its own allow.
    match /loyaltyAccounts/{customerId} {
      allow read: if worksTheBook();
      allow write: if false;

      match /badgeProgress/{seriesId} {
        allow read: if worksTheBook();
        allow write: if false;
      }

      match /seasonProgress/{seasonId} {
        allow read: if worksTheBook();
        allow write: if false;
      }
    }

    // `clientJournal/{customerId}_{seq:06}` — append-only, server-written,
    // keyed by the client RECORD (D29, flip 3). The book reads the
    // client-visible rows only; a staff row (a pause, an outcome correction)
    // is the front desk's business elsewhere. Rules are not filters: a query
    // that could return a staff row is refused whole, so the ledger query
    // names `journalVisibility == 'CLIENT'` (the flat root key, Law 6).
    match /clientJournal/{entryId} {
      allow read: if worksTheBook() && resource.data.journalVisibility == 'CLIENT';
      allow write: if false;
    }

    // ── catalog (public browse, no client write) ──────────────────────────
    // `/book` lists the catalogue anonymously (`catalogReadPorts`: the
    // active services, barbers and shops, every category). No client writes
    // it (pass E, DEP-6): no web adapter does — `catalog.adapter.ts` only
    // reads — so the catalogue-manager grant that stood here was a browser
    // write path no app code used. The Admin SDK is the one writer (the dev
    // seed `tools/seed-dev-catalog.mjs`, which the e2e global setup runs,
    // and Cloud Functions), and it bypasses these rules.
    match /serviceCategories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }

    match /services/{serviceId} {
      allow read: if true;
      allow write: if false;
    }

    match /barbers/{barberId} {
      allow read: if true;
      allow write: if false;
    }

    match /locations/{locationId} {
      allow read: if true;
      allow write: if false;
    }

    // ── availability (public read, PII-free by construction) ─────────────
    // `/book` is browsable ANONYMOUSLY, and rules cannot redact fields: a
    // document is readable whole or not at all. So the two collections a
    // visitor needs in order to see a free slot hold geometry and nothing
    // else — no client identity, no service, no price, and above all no
    // reason (a `sick` day is GDPR Art. 9 special-category data and must
    // never reach this surface). Anything richer belongs in `appointments`,
    // which stays closed.
    match /barberSchedules/{barberId} {
      allow read: if true;
      // Utilisation history DIVIDES BY the rosters, so a blanket staff write
      // let any barber rewrite any other barber's week (and a
      // `content_manager` rewrite all of them), silently changing everyone's
      // utilisation denominator. The roster-editor grant that replaced it
      // had no writer either: no web adapter writes a roster
      // (`schedulingReadPorts.observeSchedule` only reads). Closed (pass E,
      // DEP-6); the Admin SDK (the dev seed, which the e2e global setup
      // runs, and Cloud Functions) is the one writer.
      allow write: if false;
    }

    match /scheduleExceptions/{dayDocId} {
      // The sanitized availability effect of a day off / changed hours —
      // geometry only, structurally reason-free (the doc schema has no field
      // a reason could ride in; a `sick` day must never be derivable here).
      allow read: if true;
      // The roster editors' boundary — see `mayEditRoster`. The live writer
      // is the staff's pen on the day, `scheduleExceptionPorts`
      // (`scheduling.adapter.ts`, one transaction per edit).
      allow write: if mayEditRoster();
    }

    match /capacity/{monthId} {
      // The calendar's month rollup — free minutes per day/barber/shop,
      // trigger-maintained (Admin SDK). Same PII posture as barberBusy:
      // geometry-derived numbers only.
      allow read: if true;
      allow write: if false;
    }

    match /barberLeadTimeSamples/{sampleId} {
      // How far out each barber's first free day was, sampled daily by
      // `sampleBarberLeadTimeDaily` (Admin SDK, so no write allowance is
      // needed or wanted here).
      //
      // STAFF-ONLY, unlike the capacity rollup it is derived from — and the
      // difference is deliberate. Capacity says "this day has free minutes",
      // which is what a visitor already learns from the booking calendar. A
      // lead-time SERIES says how heavily booked the shop is and which way
      // that is trending, which is commercial intelligence: it is the number
      // a competitor would use to time their own pricing, and no client needs
      // it to book a haircut.
      allow read: if isStaff();
      allow write: if false;
    }

    match /barberBusy/{dayDocId} {
      allow read: if true;
      // Written ONLY by the `commitBooking` transaction (Admin SDK, which
      // bypasses rules). A client that could widen its own busy projection
      // could hide a barber's free time from everyone else.
      allow write: if false;
    }

    match /waitlistRequests/{requestId} {
      // A standing request to be told when a day opens up. The owner reads
      // their own; staff read all of them, because "who is waiting for
      // Saturday" is a question the shop legitimately asks.
      allow read: if isSignedIn()
        && (isOwner(resource.data.ownerUserId) || isStaff());

      // Written ONLY by `requestWaitlist` and the matcher (Admin SDK, which
      // bypasses rules). A client that could write its own document could
      // name a different owner and sign a stranger up for notifications, or
      // set `localDates` wider than the days it actually declared and make
      // the matcher do unbounded work on every cancellation.
      allow create: if false;

      // Withdrawal goes through the `cancelWaitlist` callable — ONE door.
      // A direct-write grant briefly lived here that nothing exercised (the
      // client gateway already called the callable, which didn't exist);
      // two sanctioned paths to one transition is how they drift.
      allow update: if false;

      allow delete: if false;
    }

    // ── programs (public browse, catalogue-manager write, shape-checked) ──
    // Open positions, courses and shop events: public read; a catalogue
    // manager (`content_manager`/`admin`/`sysadmin`) writes them straight
    // from the browser through `programsPorts` (`programs.adapter.ts`
    // `saveBody`: ONE full-document `setDoc` of the entity minus `id`,
    // never a merge, never a delete). Since pass E (E-15, DEP-7) a create
    // or an update must BE that body — `validPosition` / `validCourse` /
    // `validEvent` above — and no client deletes one.
    match /positions/{positionId} {
      allow read: if true;
      allow create, update: if isCatalogManager() && validPosition(request.resource.data);
      allow delete: if false;
    }

    match /courses/{courseId} {
      allow read: if true;
      allow create, update: if isCatalogManager() && validCourse(request.resource.data);
      allow delete: if false;
    }

    match /events/{eventId} {
      allow read: if true;
      allow create, update: if isCatalogManager() && validEvent(request.resource.data);
      allow delete: if false;
    }

    // ── engagement ──────────────────────────────────────────────────────
    // Readable by every signed-in account: a `CouponGrant` carries its own
    // value snapshot but not the coupon's name and terms, so the browser
    // joins a grant to its `Coupon` definition (`couponVoucherPorts`:
    // `loadCoupons` by the grants' ids, `findCouponByCode` for a typed
    // code, `listOpenCoupons`). Only the admin writes one.
    match /coupons/{couponId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // GIFT VOUCHERS — money the shop was paid (2026-09-10). The holder may
    // read their own balance; the book reads any, because a code presented
    // at the counter has to be looked up before it is honoured. Never
    // written from a client: a balance moves only inside the server
    // transaction that writes the visit drawing on it.
    // The holder is the ACCOUNT in `holderUserId` (D29), written at the
    // boundary from the record in `issuedToCustomerId`; a paper voucher has
    // neither, and only the book reads it.
    match /giftVouchers/{voucherId} {
      allow get, list: if isSignedIn()
        && (resource.data.holderUserId == request.auth.uid || worksTheBook());
      allow write: if false;
    }

    match /invitations/{invitationId} {
      // GET only for a plain user: the client flow is a point lookup of a
      // code someone handed you. `read` covered `list` too, which let any
      // fresh account enumerate every invitation and self-redeem it.
      allow get: if isSignedIn();
      allow list: if isStaff();
      // No client writes an invitation (Phase 4a 4A-3 (5)): its count moves
      // only inside the `redeemInvitation` callable's transaction, beside the
      // redemption it records — a client `+1` could count a redemption that
      // was never written, or skip the self-redemption check.
      allow create, update, delete: if false;

      match /redemptions/{refereeUserId} {
        // Same split: doc ids ARE referee uids, so a listing is a referral
        // graph dump.
        allow get: if isSignedIn();
        allow list: if isStaff();
        // Doc id IS the referee's uid — existence alone prevents double
        // redemption. Written only by the `redeemInvitation` callable (Admin
        // SDK), which refuses a self-redemption and moves the invitation's
        // count in the same transaction (Phase 4a 4A-3 (5)).
        allow create, update, delete: if false;
      }
    }

    // ── governance (admin-tier only) ───────────────────────────────────
    match /impersonationSessions/{sessionId} {
      // The flat `ImpersonationSession` body (`impersonationStatus`,
      // `*UtcMs` stamps at the root); the admin pair may read it, and no
      // web adapter does today. Written only by the
      // `startImpersonation`/`endImpersonation` callables (Admin SDK,
      // Phase 4a 4A-3 (4)) — which stamp the TTL's `purgeAt` a browser
      // write never could.
      allow read: if isAdmin();
      allow write: if false;
    }

    match /auditLog/{entryId} {
      // Admins read; nobody writes from a client (FIX 1, 2026-09-25). An
      // admin-side `create` let a browser append a row naming any actor at
      // any time, and a trail the people it records can write proves
      // nothing. Rows come from the callables and triggers (Admin SDK)
      // only, and are never updated or deleted.
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // ── tenant settings ─────────────────────────────────────────────────
    // `settings/bookingPolicy` — the flat `BookingPolicySettings`, read live
    // by `schedulingReadPorts.observePolicy`. Public-read because the booking
    // horizon is literally how far an anonymous visitor's calendar scrolls —
    // and the doc holds tuning numbers, nothing secret. The missing match
    // here once default-denied every `/book` session into a silent
    // defaults-only policy plus a per-tab retry loop.
    match /settings/{docId} {
      allow read: if true;
      // No client writes the settings (pass E, DEP-6): no web adapter does
      // — `schedulingReadPorts.observePolicy` only reads — so the admin
      // grant that stood here was a browser write path no app code used.
      // The Admin SDK (the dev seed, Cloud Functions) is the one writer.
      allow write: if false;
    }

    // ── server-only (Admin SDK bypasses rules; closed to every client) ──
    match /otps/{otpId} {
      // The flat `Otp` body, written by `firestoreOtpPorts` and the
      // `verifyOtp` pipeline's plan, TTL-purged on `purgeAt`.
      allow read, write: if false;
    }

  }
}
