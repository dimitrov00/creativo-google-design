rules_version = '2';

// The Cloud Storage rules for the `libs/infrastructure/storage` adapters,
// bound in `apps/web/src/app/app.config.ts`: a person's avatar
// (`avatarPorts`, `avatar.adapter.ts`), the catalogue's media library
// (`mediaResolvePorts`, `media-resolve.adapter.ts`, read only) and the
// shop's photos of a visit (`appointmentPhotoPorts`,
// `appointment-photos.adapter.ts`). Default-deny root: a path no match names
// stays closed. Media library assets are put in place by staff tooling with
// admin credentials (which bypass rules), never uploaded by a client.
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // The roles that WORK THE BOOK — the same grouping `firestore.rules`
    // gates the appointments and the team's notes on. Custom claims ride
    // the token here exactly as there.
    function worksTheBook() {
      return isSignedIn() && 'roles' in request.auth.token
        && request.auth.token.roles.hasAny(['barber', 'receptionist', 'admin', 'sysadmin']);
    }

    // An erased account (`users/{uid}.accountStatus` ERASED, audit hardening
    // Phase 3) keeps a valid ID token for up to an hour after its Auth user
    // is deleted; it uploads nothing in that hour. ONE cross-service read per
    // upload (rules v2; the deploy grants the Storage rules agent Firestore
    // read — production-deploy.md). No `users` document reads as no account:
    // refused. Evaluated last, after the cheap checks.
    function accountMayUpload(uid) {
      return firestore.get(/databases/(default)/documents/users/$(uid)).data.accountStatus != 'ERASED';
    }

    // One object per user (`avatars/{userId}/original`, `avatarPorts`),
    // overwritten on re-upload. Publicly readable (avatars are shown across
    // staff dashboards and to other booking parties, and carry no sensitive
    // data) — writes restricted to the owner, capped at 5 MiB, image
    // content-types only, and refused to an erased account
    // (`accountMayUpload`, Phase 4 S-RU-4).
    //
    // `create`/`update` and `delete` are split deliberately: `write` covers
    // all three, but on a DELETE `request.resource` is null, so the size and
    // content-type checks below can never pass — a single `allow write` rule
    // silently makes deletion impossible. Owners may drop their own avatar
    // (the profile screen's "Remove photo", `removeAvatar`) — an erased
    // owner too: a delete reads no account; the size/type guards only make
    // sense where there IS an incoming object.
    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if isOwner(userId)
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')
        && accountMayUpload(userId);
      allow delete: if isOwner(userId);
    }

    // Catalog media library (service covers, location photos — the assets
    // a stored `MediaRef`'s `mediaPath` points at, resolved client-side by
    // `mediaResolvePorts`): public marketing/catalog content, readable by
    // anyone; written only by staff tooling with admin credentials (which
    // bypass rules), never by clients.
    match /media/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // The shop's photos of a visit (`appointmentPhotoPorts`, one object
    // per photo under its visit): staff-only both ways, like the Firestore
    // document beside each — a client never reads the shop's pictures of
    // them here. Create/update and delete are split as for avatars: on a
    // DELETE `request.resource` is null.
    match /appointmentPhotos/{appointmentId}/{photoId} {
      allow read: if worksTheBook();
      allow create, update: if worksTheBook()
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if worksTheBook();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
