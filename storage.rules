rules_version = '2';

// Fresh policy for Goal 04's `libs/infrastructure/storage` adapters
// (`FirebaseStorageAvatarUploader`) — replaces the earlier Foundation-pass
// placeholder deny-all. Media library assets (catalog/location photos,
// resolved by `StorageMediaReader` via `MediaRef.path`) are managed
// server-side/by staff tooling, not uploaded by clients, so only the
// avatar path is opened up here.
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // The roles that WORK THE BOOK — the same grouping `firestore.rules`
    // gates the appointments and the team's notes on. Custom claims ride
    // the token here exactly as there.
    function worksTheBook() {
      return isSignedIn() && 'roles' in request.auth.token
        && request.auth.token.roles.hasAny(['barber', 'receptionist', 'admin', 'sysadmin']);
    }

    // One object per user, overwritten on re-upload. Publicly readable
    // (avatars are shown across staff dashboards and to other booking
    // parties, and carry no sensitive data) — writes restricted to the
    // owner, capped at 5 MiB, image content-types only.
    //
    // `create`/`update` and `delete` are split deliberately: `write` covers
    // all three, but on a DELETE `request.resource` is null, so the size and
    // content-type checks below can never pass — a single `allow write` rule
    // silently makes deletion impossible. Owners may drop their own avatar
    // (the profile screen's "Remove photo"); the size/type guards only make
    // sense where there IS an incoming object.
    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if isOwner(userId)
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isOwner(userId);
    }

    // Catalog media library (service covers, location photos — the assets
    // `MediaRef.path` points at, resolved client-side by
    // `StorageMediaReader`): public marketing/catalog content, readable by
    // anyone; written only by staff tooling with admin credentials (which
    // bypass rules), never by clients.
    match /media/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // The shop's photos of a visit (`FirebaseAppointmentPhotos`, one object
    // per photo under its visit): staff-only both ways, like the Firestore
    // document beside each — a client never reads the shop's pictures of
    // them here. Create/update and delete are split as for avatars: on a
    // DELETE `request.resource` is null.
    match /appointmentPhotos/{appointmentId}/{photoId} {
      allow read: if worksTheBook();
      allow create, update: if worksTheBook()
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if worksTheBook();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
