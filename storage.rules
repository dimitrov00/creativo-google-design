rules_version = '2';

// The Cloud Storage rules for the `libs/infrastructure/storage` adapters,
// bound in `apps/web/src/app/app.config.ts`: a person's avatar
// (`avatarPorts`, `avatar.adapter.ts`), the catalogue's media library
// (`mediaResolvePorts`, `media-resolve.adapter.ts`, read only) and the
// shop's photos of a visit (`appointmentPhotoPorts`,
// `appointment-photos.adapter.ts`). Default-deny root: a path no match names
// stays closed. Media library assets are put in place by staff tooling with
// admin credentials (which bypass rules), never uploaded by a client.
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // The roles that WORK THE BOOK — the same grouping `firestore.rules`
    // gates the appointments and the team's notes on. Custom claims ride
    // the token here exactly as there.
    function worksTheBook() {
      return isSignedIn() && 'roles' in request.auth.token
        && request.auth.token.roles.hasAny(['barber', 'receptionist', 'admin', 'sysadmin']);
    }

    // An erased account (`users/{uid}.accountStatus` ERASED, audit hardening
    // Phase 3) keeps a valid ID token for up to an hour after its Auth user
    // is deleted; it uploads nothing in that hour. ONE cross-service read per
    // upload (rules v2; the deploy grants the Storage rules agent Firestore
    // read — production-deploy.md). No `users` document reads as no account:
    // refused. Evaluated last, after the cheap checks.
    function accountMayUpload(uid) {
      return firestore.get(/databases/(default)/documents/users/$(uid)).data.accountStatus != 'ERASED';
    }

    // A barber's photo is the shop's (one photo per barber, decision F7 of
    // docs/architecture/decisions/2026-11-15-one-photo-per-barber.md): an
    // account linked to a barber record (`users/{uid}.linkedBarberId`, set
    // by `setRoles` alone) keeps no avatar of its own. Its avatar object is
    // the record's photo, copied there by the server (Admin SDK, which
    // bypasses rules) — so the two can never differ. An absent field (a
    // document written before the link existed) and `null` read as not
    // linked; no `users` document reads as not linked too, so a delete by
    // an account that is gone still passes. The same document
    // `accountMayUpload` reads: one read per request.
    function isLinkedBarber(uid) {
      return firestore.exists(/databases/(default)/documents/users/$(uid))
        && firestore.get(/databases/(default)/documents/users/$(uid)).data.get('linkedBarberId', null) != null;
    }

    // One object per user (`avatars/{userId}/original`, `avatarPorts`),
    // overwritten on re-upload. Publicly readable (avatars are shown across
    // staff dashboards and to other booking parties, and carry no sensitive
    // data) — writes restricted to the owner, capped at 5 MiB, image
    // content-types only, refused to an erased account
    // (`accountMayUpload`, Phase 4 S-RU-4) and to an account linked to a
    // barber record (`isLinkedBarber`): a barber changes their photo
    // through `setBarberPhoto`.
    //
    // `create`/`update` and `delete` are split deliberately: `write` covers
    // all three, but on a DELETE `request.resource` is null, so the size and
    // content-type checks below can never pass — a single `allow write` rule
    // silently makes deletion impossible. Owners may drop their own avatar
    // (the profile screen's "Remove photo", `removeAvatar`) — an erased
    // owner too: a delete asks only whether the account is a barber's
    // (whose photo is not theirs to drop); the size/type guards only make
    // sense where there IS an incoming object.
    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if isOwner(userId)
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')
        && accountMayUpload(userId)
        && !isLinkedBarber(userId);
      allow delete: if isOwner(userId) && !isLinkedBarber(userId);
    }

    // Catalog media library (service covers, location photos, a barber's
    // photo — the assets a stored `MediaRef`'s `mediaPath` points at,
    // resolved client-side by `mediaResolvePorts`): public marketing/catalog
    // content, FETCHED by anyone who knows its path; written only with admin
    // credentials (staff tooling, and the `setBarberPhoto` callable — both
    // bypass rules), never by clients.
    //
    // `get`, never `list`: a barber record in preparation is staff-only, and
    // its photo's unguessable object name is all that keeps the face from
    // the public — a listing of `media/barbers/…` would hand it over. No
    // client lists `media/`: every reader holds a path.
    match /media/{allPaths=**} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }

    // Any staff role's claim — the token gate the team callables ask before
    // they read the stored account (`admitTeamCaller`).
    function isStaff() {
      return isSignedIn() && 'roles' in request.auth.token
        && request.auth.token.roles.hasAny(['barber', 'receptionist', 'content_manager', 'admin', 'sysadmin']);
    }

    // A staff member's STAGED upload (`stagedUploadPorts`): the picture a
    // callable is about to take — today a barber's photo, `setBarberPhoto`
    // (docs/architecture/decisions/2026-11-15-one-photo-per-barber.md). The
    // rules cannot ask who may edit a barber (that is the owner's permission
    // cells, judged on the stored account), so the browser writes HERE, under
    // its own uid, and the callable reads it with admin credentials, checks
    // it again, copies it into `media/` and deletes it. Nobody reads a staged
    // file through the rules — not even its owner: it is in transit. A staff
    // token, the owner's own folder, an image under 5 MiB
    // (`BarberPhotoSystem.MAX_BYTES`).
    match /staffUploads/{userId}/{fileName} {
      allow read: if false;
      allow create, update: if isOwner(userId)
        && isStaff()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isOwner(userId);
    }

    // The shop's photos of a visit (`appointmentPhotoPorts`, one object
    // per photo under its visit): staff-only both ways, like the Firestore
    // document beside each — a client never reads the shop's pictures of
    // them here. Create/update and delete are split as for avatars: on a
    // DELETE `request.resource` is null.
    match /appointmentPhotos/{appointmentId}/{photoId} {
      allow read: if worksTheBook();
      allow create, update: if worksTheBook()
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if worksTheBook();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
